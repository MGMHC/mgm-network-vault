<?xml version="1.0" encoding="UTF-8"?>
<!--
  MGM Network Vault behind IIS (reverse proxy).
  Requires the IIS modules "URL Rewrite 2.1" and "Application Request Routing 3.0" with proxy enabled
  (deploy\iis\setup-iis.ps1 does this). Place this file in the root folder of the IIS site.
  The app itself listens on http://127.0.0.1:8080 (see config.toml).

  Performance notes:
  - HTTP/2 is enabled via <webSocket enabled="false"> which is required by IIS to activate HTTP/2
    (IIS cannot use HTTP/2 and WebSocket on the same binding simultaneously).
  - Static assets (JS/CSS/fonts/images) are served with a 7-day Cache-Control max-age so browsers
    skip re-downloading them on repeat visits.
  - Dynamic responses (HTML, API) are explicitly marked no-store so sensitive data is never cached.
  - GZip/dynamic compression reduces transfer size for text-based responses.
  - ARR keeps persistent connections to Waitress via the proxy connection pool (configured in IIS
    Manager → Application Request Routing → Server Proxy Settings).
-->
<configuration>
  <system.webServer>

    <!-- HTTP/2 is enabled automatically by IIS 10 on HTTPS bindings — no extra config needed. -->

    <!-- ═══════════════════════════════════════════════════
         GZip / dynamic compression — reduces payload size
         for HTML, JSON, and CSS responses by 60–80 %.
         Requires the IIS "Dynamic Content Compression"
         feature to be installed (usually already present).
    ════════════════════════════════════════════════════ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ═══════════════════════════════════════════════════
         URL Rewrite rules
    ════════════════════════════════════════════════════ -->
    <rewrite>
      <rules>
        <!-- Send plain-HTTP visitors to HTTPS (logins must never travel unencrypted) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Forward everything to the app; tell it the original host and scheme -->
        <rule name="MGM Network Vault" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
        </rule>
      </rules>

      <!-- ─────────────────────────────────────────────────
           Outbound rules: stamp Cache-Control headers on
           responses coming back from Waitress so browsers
           know what they can cache and for how long.
      ────────────────────────────────────────────────── -->
      <outboundRules>

        <!-- Static assets: JS, CSS, fonts, images — safe to
             cache for 7 days; Flask/Jinja fingerprints them
             with ?v= query strings when they change.        -->
        <rule name="Cache static assets" preCondition="IsStaticAsset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=604800, stale-while-revalidate=86400" />
        </rule>

        <!-- Dynamic pages / API responses — never cache;
             contains user-specific or sensitive data.       -->
        <rule name="No-cache dynamic responses" preCondition="IsDynamicResponse">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-store, no-cache, must-revalidate" />
        </rule>

        <preConditions>
          <preCondition name="IsStaticAsset">
            <add input="{REQUEST_URI}" pattern="\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|map)(\?.*)?$" />
          </preCondition>
          <preCondition name="IsDynamicResponse">
            <add input="{REQUEST_URI}" pattern="\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|map)(\?.*)?$" negate="true" />
          </preCondition>
        </preConditions>

      </outboundRules>
    </rewrite>

    <!-- ═══════════════════════════════════════════════════
         Security
    ════════════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <!-- allow uploading large .nvault exports (4 GB) -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>

    <!-- ═══════════════════════════════════════════════════
         Response headers
    ════════════════════════════════════════════════════ -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
